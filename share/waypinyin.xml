<?xml version="1.0" encoding="utf-8"?>
<component>
    <name>org.freedesktop.IBus.Waypinyin</name>
    <description>Pinyin input for GNOME Wayland</description>
    <exec>@BINDIR@/waypinyin</exec>
    <version>0.1.0</version>
    <author>emt</author>
    <license>MIT</license>
    <homepage>https://github.com/ffgan/waypinyin</homepage>
    <textdomain>waypinyin</textdomain>
    <engines>
        <engine>
            <name>waypinyin</name>
            <language>zh</language>
            <license>MIT</license>
            <author>emt</author>
            <layout>default</layout>
            <longname>Waypinyin</longname>
            <description>Pinyin</description>
            <icon>waypinyin</icon>
            <symbol>拼</symbol>
            <setup>@BINDIR@/waypinyin --settings</setup>
            <rank>80</rank>
        </engine>
    </engines>
</component>
