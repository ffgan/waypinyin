#!/usr/bin/make -f
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_NET_OFFLINE = true
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "debian"\n[source.debian]\ndirectory = "/usr/share/cargo/registry"\n' > $(CARGO_HOME)/config.toml

# The distribution registry may resolve different patched crate revisions.
# Build offline without --locked, retaining the upstream lockfile as a reference.
override_dh_auto_build:
	$(MAKE) build PREFIX=/usr CARGO_BUILD_FLAGS='--offline --no-default-features'

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	WAYPINYIN_LEXICON=$(CURDIR)/build/lexicon.bin cargo test --offline --no-default-features
endif

override_dh_auto_install:
	python3 scripts/install.py

# Environment is shared with the direct install script.
export PREFIX = /usr
export DESTDIR = $(CURDIR)/debian/waypinyin

override_dh_auto_clean:
	rm -rf build target debian/cargo-home
